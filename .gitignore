# Private keys and certs. The mkcert local-dev certs these were added for went
# with the v1 web frontend; the rules stay as a standing guard against ever
# committing key material.
*.pem
*.key
*.crt

.vscode/
.idea/
*.swp
*.swo

.DS_Store
Thumbs.db

# Models and Data
# Anchored to the repo root: an unanchored `models/` also matches src/models/,
# which is the L3 layer package (DraftEngineDesign.md §9.0) and must be tracked.
/models/
*.pkl
# local HTTP cache (FFC/CFBD) — regenerable, not source
# Draft-night state stays local: session logs, archives and the decision
# ledger are personal and change constantly.
data/web/
data/raw/
data/blobs/

# The FITTED artifacts and the bundle ARE tracked. They are the product of a
# ~20-minute pipeline plus a CFBD pull, and losing the laptop before draft day
# would mean rebuilding from scratch. `scripts/prune_artifacts.py` keeps the
# directory to one live generation (~1 MB); without it, every run adds another.
data/*
!data/artifacts/
!data/bundles/

.agents/
.claude/*
CLAUDE.md
.pytest_cache/

notes/

# Yahoo OAuth token cache (probe + live client)
.yahoo_token.json

# web cockpit frontend
web/node_modules/
web/dist/
